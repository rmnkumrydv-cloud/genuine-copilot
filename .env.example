# Copy to .env and fill in. The deterministic core (Gates 0-3) needs NONE of these.

# GitHub ingestion. Optional: unauthenticated works but hits a 60 req/hr limit.
# A classic/fine-grained token with public_repo scope raises it to 5000/hr.
GITHUB_TOKEN=

# LLM explainer (Gate 5). Spec uses Groq LLaMA-3.3-70B.
# Without this, the deterministic template-fallback report is used instead.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Storage locations (defaults are fine).
GENUINE_DB_PATH=data/genuine.sqlite
GENUINE_CLONE_CACHE=data/clones
